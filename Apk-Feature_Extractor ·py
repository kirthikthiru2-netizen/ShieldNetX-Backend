"""
apk_feature_extractor.py
Static analysis feature extraction for Android APK files.
No sandboxing / dynamic execution — everything here is fast, static
parsing of the APK's manifest, certificate, and DEX, so it comfortably
fits inside typical free-tier hosting limits (e.g. Render's default
timeout, Railway, etc).
"""

import re
from androguard.core.apk import APK

# Permissions commonly abused together by banking trojans / spyware /
# fake-installer malware. Individually many are legitimate; the
# combination is the red flag.
DANGEROUS_PERMISSIONS = {
    "android.permission.SEND_SMS",
    "android.permission.RECEIVE_SMS",
    "android.permission.READ_SMS",
    "android.permission.READ_CONTACTS",
    "android.permission.CALL_PHONE",
    "android.permission.READ_CALL_LOG",
    "android.permission.RECORD_AUDIO",
    "android.permission.CAMERA",
    "android.permission.READ_PHONE_STATE",
    "android.permission.SYSTEM_ALERT_WINDOW",
    "android.permission.REQUEST_INSTALL_PACKAGES",
    "android.permission.BIND_ACCESSIBILITY_SERVICE",
    "android.permission.BIND_DEVICE_ADMIN",
    "android.permission.WRITE_SETTINGS",
    "android.permission.PACKAGE_USAGE_STATS",
    "android.permission.RECEIVE_BOOT_COMPLETED",
    "android.permission.QUERY_ALL_PACKAGES",
}

# Package-name prefixes of well-known apps that are frequently spoofed
# by fake/clone APKs (WhatsApp, banking apps, etc). This is only used
# to flag "claims to be X but isn't signed like X" style mismatches at
# a coarse level — it is NOT a full trust database.
COMMONLY_SPOOFED_PREFIXES = [
    "com.whatsapp", "com.facebook", "com.instagram", "com.google.android",
    "com.android.vending", "com.paypal", "com.amazon", "com.netflix",
    "in.amazon", "com.phonepe", "net.one97.paytm", "com.sbi", "com.icici",
]

SUSPICIOUS_STRINGS = [
    "DexClassLoader", "loadDexFile", "getRuntime().exec",
    "System.loadLibrary", "base64decode", "Cipher.getInstance",
]


class APKFeatureExtractor:
    def extract(self, apk_path: str) -> dict:
        features = {name: 0 for name in self.FEATURE_NAMES}

        try:
            apk = APK(apk_path)
        except Exception as e:
            # If the file can't even be parsed as a valid APK, that is
            # itself a strong signal — corrupted/malformed APKs are a
            # common malware-dropper technique to dodge some scanners.
            features["is_unparseable"] = 1
            features["parse_error"] = str(e)[:200]
            return features

        # ── Signing / integrity ──────────────────────────────────
        try:
            is_signed = apk.is_signed()
            features["is_signed"] = int(bool(is_signed))
        except Exception:
            features["is_signed"] = 0

        try:
            v1 = apk.is_signed_v1()
            v2 = apk.is_signed_v2()
            v3 = apk.is_signed_v3()
            features["has_modern_signature"] = int(bool(v2 or v3))
            features["v1_only_signature"] = int(bool(v1 and not (v2 or v3)))
        except Exception:
            pass

        # ── Manifest flags ───────────────────────────────────────
        try:
            features["is_debuggable"] = int(bool(apk.get_attribute_value(
                "application", "debuggable")))
        except Exception:
            pass

        try:
            features["allows_backup"] = int(
                apk.get_attribute_value("application", "allowBackup") != "false"
            )
        except Exception:
            features["allows_backup"] = 1  # defaults to true if unspecified

        try:
            min_sdk = apk.get_min_sdk_version()
            features["min_sdk_low"] = int(min_sdk is not None and int(min_sdk) < 21)
        except Exception:
            pass

        # ── Permissions ───────────────────────────────────────────
        try:
            perms = set(apk.get_permissions())
            dangerous_found = perms & DANGEROUS_PERMISSIONS
            features["dangerous_permission_count"] = len(dangerous_found)

            features["has_sms_permissions"] = int(
                bool(perms & {"android.permission.SEND_SMS",
                              "android.permission.RECEIVE_SMS",
                              "android.permission.READ_SMS"})
            )
            features["has_install_packages_permission"] = int(
                "android.permission.REQUEST_INSTALL_PACKAGES" in perms
            )
            features["has_overlay_permission"] = int(
                "android.permission.SYSTEM_ALERT_WINDOW" in perms
            )
            features["has_accessibility_permission"] = int(
                "android.permission.BIND_ACCESSIBILITY_SERVICE" in perms
            )
            features["has_device_admin_permission"] = int(
                "android.permission.BIND_DEVICE_ADMIN" in perms
            )
            features["has_contacts_permission"] = int(
                "android.permission.READ_CONTACTS" in perms
            )

            # Classic banking-trojan combo: SMS + contacts + overlay/install
            features["has_trojan_permission_combo"] = int(
                features["has_sms_permissions"]
                and (features["has_overlay_permission"]
                     or features["has_install_packages_permission"])
            )

            features["total_permission_count"] = len(perms)
        except Exception:
            pass

        # ── Package identity / spoofing check ───────────────────
        try:
            pkg = apk.get_package() or ""
            features["mimics_known_app_name"] = int(any(
                pkg.startswith(prefix) for prefix in COMMONLY_SPOOFED_PREFIXES
            ))
        except Exception:
            pkg = ""

        # ── Component surface area (rough proxy for attack surface) ─
        try:
            exported_activities = apk.get_activities()
            exported_receivers = apk.get_receivers()
            exported_services = apk.get_services()
            features["component_count"] = (
                len(exported_activities or [])
                + len(exported_receivers or [])
                + len(exported_services or [])
            )
        except Exception:
            pass

        # ── DEX / string-level heuristics ────────────────────────
        try:
            all_strings = " ".join(apk.get_files())
            dex_files = [f for f in apk.get_files() if f.endswith(".dex")]
            features["multidex"] = int(len(dex_files) > 1)
        except Exception:
            pass

        try:
            raw = b""
            for dex_name in apk.get_files():
                if dex_name.endswith(".dex"):
                    raw += apk.get_file(dex_name)
            text_blob = raw.decode("latin-1", errors="ignore")
            hits = sum(1 for s in SUSPICIOUS_STRINGS if s in text_blob)
            features["suspicious_code_string_hits"] = hits
            features["uses_dynamic_code_loading"] = int(
                "DexClassLoader" in text_blob or "loadDexFile" in text_blob
            )
            features["uses_native_libs"] = int(
                any(f.startswith("lib/") and f.endswith(".so")
                    for f in apk.get_files())
            )
        except Exception:
            pass

        # ── Missing launcher icon (some repackaged/fake apps ship
        #     with a broken or absent icon resource) ──────────────
        try:
            icon = apk.get_app_icon()
            features["has_launcher_icon"] = int(bool(icon))
        except Exception:
            features["has_launcher_icon"] = 1  # don't penalize on parse issues

        return features

    FEATURE_NAMES = [
        "is_unparseable",
        "is_signed",
        "has_modern_signature",
        "v1_only_signature",
        "is_debuggable",
        "allows_backup",
        "min_sdk_low",
        "dangerous_permission_count",
        "has_sms_permissions",
        "has_install_packages_permission",
        "has_overlay_permission",
        "has_accessibility_permission",
        "has_device_admin_permission",
        "has_contacts_permission",
        "has_trojan_permission_combo",
        "total_permission_count",
        "mimics_known_app_name",
        "component_count",
        "multidex",
        "suspicious_code_string_hits",
        "uses_dynamic_code_loading",
        "uses_native_libs",
        "has_launcher_icon",
    ]
